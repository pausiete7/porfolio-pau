---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { DEFAULT_LANG, LANGUAGES, type Lang } from "@/i18n";
import { COPY, CONTACT } from "@data/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = COPY[lang];
const site = Astro.site ?? new URL("https://pausevilla.com");
const langs = Object.keys(LANGUAGES) as Lang[];
const pathFor = (l: Lang) => (l === DEFAULT_LANG ? "/" : `/${l}/`);
const canonical = new URL(pathFor(lang), site).href;
const ogImage = new URL("/og.jpg", site).href;
const ogLocale = { es: "es_ES", en: "en_US", ca: "ca_ES" }[lang];

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Pau Sevilla Rodríguez",
  url: site.href,
  image: ogImage,
  jobTitle: { es: "Desarrollador full-stack y móvil", en: "Full-stack and mobile developer", ca: "Desenvolupador full-stack i mòbil" }[lang],
  email: `mailto:${CONTACT.email}`,
  address: { "@type": "PostalAddress", addressLocality: "Barcelona", addressCountry: "ES" },
  worksFor: { "@type": "Organization", name: "inLab FIB", url: "https://inlab.fib.upc.edu/" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "Facultat d'Informàtica de Barcelona (UPC)" },
  sameAs: [CONTACT.linkedin, CONTACT.github, CONTACT.instagram, CONTACT.x],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.meta.title}</title>
    <meta name="description" content={copy.meta.description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(l), site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL("/", site).href} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101216" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/public-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={copy.meta.title} />
    <meta property="og:description" content={copy.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>
  <body>
    <a class="skip" href="#contenido">{copy.skip}</a>
    <Header lang={lang} />
    <slot />
    <Footer lang={lang} />
  </body>
</html>

<style is:global>
  @font-face { font-family: "Public Sans"; font-weight: 400; font-display: swap; src: url("/fonts/public-sans-latin-400-normal.woff2") format("woff2"); }
  @font-face { font-family: "Public Sans"; font-weight: 600; font-display: swap; src: url("/fonts/public-sans-latin-600-normal.woff2") format("woff2"); }
  @font-face { font-family: "Public Sans"; font-weight: 700; font-display: swap; src: url("/fonts/public-sans-latin-700-normal.woff2") format("woff2"); }
  @font-face { font-family: "Newsreader"; font-weight: 500; font-display: swap; src: url("/fonts/newsreader-latin-500-normal.woff2") format("woff2"); }
  @font-face { font-family: "Newsreader"; font-weight: 500; font-style: italic; font-display: swap; src: url("/fonts/newsreader-latin-500-italic.woff2") format("woff2"); }
  @font-face { font-family: "Newsreader"; font-weight: 600; font-display: swap; src: url("/fonts/newsreader-latin-600-normal.woff2") format("woff2"); }

  :root {
    --bg: #f7f7f5;
    --surface: #ffffff;
    --surface-2: #eef1f5;
    --ink: #14171c;
    --muted: #535b66;
    --line: #e2e5ea;
    --accent: #1d5fd1;
    --accent-soft: #e6eefb;
    --accent-ink: #ffffff;
    --link: #1d5fd1;
    --focus: #1d5fd1;
    --radius: 14px;
    --max: 1080px;
    --font-body: "Public Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-head: "Newsreader", Georgia, "Times New Roman", serif;
    color-scheme: light dark;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #101216;
      --surface: #171a20;
      --surface-2: #1e232b;
      --ink: #e9ebee;
      --muted: #a2aab5;
      --line: #2a3039;
      --accent: #8fb5ff;
      --accent-soft: #1a2638;
      --accent-ink: #0d1726;
      --link: #9cc0ff;
      --focus: #9cc0ff;
    }
  }

  html { scroll-behavior: smooth; scroll-padding-top: 5rem; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  h1, h2, h3 { font-family: var(--font-head); font-weight: 500; line-height: 1.15; letter-spacing: -0.01em; }
  a { color: var(--link); }
  :focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; border-radius: 6px; }
  .wrap { width: min(100% - 2.5rem, var(--max)); margin-inline: auto; }

  .skip {
    position: absolute; left: 1rem; top: -3rem; z-index: 100;
    background: var(--accent); color: var(--accent-ink); padding: 0.5rem 0.9rem; border-radius: 8px;
    text-decoration: none; font-weight: 700;
  }
  .skip:focus { top: 1rem; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { transition: none !important; animation: none !important; }
  }
</style>
