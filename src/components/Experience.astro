---
import ExperienceItem from "./ExperienceItem.astro";
const EXPERIENCE = [
  {
    date: "Diciembre 2024 - Presente",
    title: "Programador web full-stack y computación - InLab FIB",
    description:
      "El inLab FIB es el laboratorio de innovación e investigación de la Facultad de Informática de Barcelona (UPC), donde se desarrollan proyectos R+D+I multidisciplinares en el ámbito TIC. He participado en proyectos muy diversos: desde desarrollo full-stack hasta iniciativas de computación. Colaboro en equipo con metodologías ágiles, implementando backend y frontend en proyectos que transfieren conocimiento e innovación al sector.",
    link: "https://inlab.fib.upc.edu/",
    image: "/inlab-fib.webp",
  },
];
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li>
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
