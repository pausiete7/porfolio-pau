---
import { LANGUAGES, DEFAULT_LANG, type Lang } from "@/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
// Orden de lectura: castellano, catalán, inglés
const langs: Lang[] = ["es", "ca", "en"];

const pathname = Astro.url.pathname;
const pathWithoutLocale = pathname.replace(/^\/(es|ca)(\/|$)/, "/");

function getLocalePath(targetLang: Lang): string {
  if (targetLang === DEFAULT_LANG) return pathWithoutLocale;
  return `/${targetLang}${pathWithoutLocale === "/" ? "/" : pathWithoutLocale}`;
}
---

<ul class="langs" aria-label="Idioma / Language">
  {
    langs.map((code) => (
      <li>
        <a
          href={getLocalePath(code)}
          hreflang={code}
          lang={code}
          aria-current={code === lang ? "true" : undefined}
          title={LANGUAGES[code]}
        >
          {code.toUpperCase()}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .langs { grid-area: lang; display: flex; list-style: none; margin: 0; padding: 0; }
  li + li::before { content: "/"; color: var(--line); padding-inline: 0.1rem; }
  li { display: flex; align-items: center; }
  a {
    display: inline-grid; place-items: center; min-width: 2.2rem; min-height: 44px;
    font-size: 0.85rem; font-weight: 600; letter-spacing: 0.04em;
    color: var(--muted); text-decoration: none;
  }
  a:hover { color: var(--ink); }
  a[aria-current="true"] { color: var(--ink); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
</style>
