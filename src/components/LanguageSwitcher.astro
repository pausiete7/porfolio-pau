---
import { LANGUAGES, DEFAULT_LANG, type Lang } from "@/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const langs = Object.keys(LANGUAGES) as Lang[];

const pathname = Astro.url.pathname;
const pathWithoutLocale = pathname.replace(/^\/(es|ca)(\/|$)/, "/");

function getLocalePath(targetLang: Lang): string {
  if (targetLang === DEFAULT_LANG) return pathWithoutLocale;
  return `/${targetLang}${pathWithoutLocale === "/" ? "/" : pathWithoutLocale}`;
}
---

<ul class="langs" aria-label="Idioma / Language">
  {
    langs.map((code) => (
      <li>
        <a
          href={getLocalePath(code)}
          hreflang={code}
          lang={code}
          aria-current={code === lang ? "true" : undefined}
          title={LANGUAGES[code]}
        >
          {code.toUpperCase()}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .langs {
    grid-area: lang;
    display: flex; gap: 0.15rem; list-style: none; margin: 0; padding: 0.2rem;
    border: 1px solid var(--line); border-radius: 999px; background: var(--surface);
  }
  a {
    display: grid; place-items: center;
    min-width: 2.5rem; min-height: 2.25rem;
    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em;
    color: var(--muted); text-decoration: none; border-radius: 999px;
  }
  a:hover { color: var(--ink); }
  a[aria-current="true"] { background: var(--accent); color: var(--accent-ink); }
</style>
