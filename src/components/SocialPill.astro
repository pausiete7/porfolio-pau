---
interface Props {
  href: string;
  target?: string;
}

const { href, target } = Astro.props;
---

<a
  class="rounded-full border border-white/10 flex justify-center items-center gap-x-2 py-1 px-2 md:py-2 md:px-4 bg-white/5 hover:scale-105 active:scale-95 hover:bg-white/10 transition-all duration-200 hover:border-white/20 hover:shadow-md hover:shadow-white/5 text-xs md:text-base"
  href={href}
  target={target}
  rel="noopener noreferrer"
>
  <slot />
</a>
