---
import LanguageSwitcher from "@components/LanguageSwitcher.astro";
import { DEFAULT_LANG, type Lang } from "@/i18n";
import { COPY } from "@data/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const nav = COPY[lang].nav;
const home = lang === DEFAULT_LANG ? "/" : `/${lang}/`;
const links = [
  { href: "#proyectos", label: nav.projects },
  { href: "#experiencia", label: nav.experience },
  { href: "#sobre-mi", label: nav.about },
  { href: "#contacto", label: nav.contact },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={home}>Pau Sevilla</a>
    <nav aria-label={lang === "en" ? "Sections" : lang === "ca" ? "Seccions" : "Secciones"}>
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <LanguageSwitcher lang={lang} />
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--bg);
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: "brand lang" "nav nav";
    align-items: center;
    column-gap: 1rem;
    padding-block: 0.6rem 0;
  }
  .brand {
    grid-area: brand;
    font-family: var(--font-head); font-weight: 600; font-size: 1.2rem;
    color: var(--ink); text-decoration: none;
  }
  nav { grid-area: nav; overflow-x: auto; scrollbar-width: none; margin-inline: -0.5rem; }
  nav::-webkit-scrollbar { display: none; }
  ul { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0.35rem 0 0.45rem; }
  nav a {
    display: inline-block; white-space: nowrap;
    padding: 0.45rem 0.5rem; min-height: 44px; box-sizing: border-box; line-height: 1.7;
    color: var(--muted); text-decoration: none; font-size: 0.92rem; border-radius: 6px;
  }
  nav a:hover { color: var(--ink); background: var(--surface-2); }

  @media (min-width: 768px) {
    .bar {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: "brand nav lang";
      padding-block: 0.7rem;
    }
    nav { margin: 0; justify-self: end; }
    ul { padding: 0; }
  }
</style>
