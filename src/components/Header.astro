---
import LanguageSwitcher from "@components/LanguageSwitcher.astro";
import ProfileIcon from "@icons/ProfileIcon.astro";
import BriefcaseIcon from "@icons/BriefcaseIcon.astro";
import BooksIcon from "@icons/BooksIcon.astro";
import CodeIcon from "@icons/CodeIcon.astro";
import BrainIcon from "@icons/BrainIcon.astro";
import { useTranslations, DEFAULT_LANG, type Lang } from "@/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const prefix = lang === DEFAULT_LANG ? "" : `/${lang}`;

const NAV_ITEMS = [
  {
    title: t("nav.about"),
    label: "sobre-mi",
    url: `${prefix}/#sobre-mi`,
    icon: ProfileIcon,
  },
  {
    title: t("nav.experience"),
    label: "experiencia",
    url: `${prefix}/#experiencia`,
    icon: BriefcaseIcon,
  },
  {
    title: t("nav.education"),
    label: "educacion",
    url: `${prefix}/#educacion`,
    icon: BooksIcon,
  },
  {
    title: t("nav.projects"),
    label: "proyectos",
    url: `${prefix}/#proyectos`,
    icon: CodeIcon,
  },
  {
    title: t("nav.skills"),
    label: "habilidades",
    url: `${prefix}/#habilidades`,
    icon: BrainIcon,
  },
];
---

<header
  class="fixed top-0 z-10 w-full mt-2"
>
  <div class="max-w-xl lg:max-w-4xl mx-auto px-2 md:px-4 flex items-center justify-between">
    <div class="w-24 shrink-0 hidden lg:block" aria-hidden="true" />
    <nav
      class="flex px-2 lg:px-3 text-sm lg:text-base font-medium rounded-full text-gray-200 justify-center items-center"
    >
      {
        NAV_ITEMS.map((link) => (
          <a
            class="relative flex items-center justify-center px-2.5 py-2 lg:px-2 transition hover:text-blue-500 whitespace-nowrap after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2 after:h-0.5 after:w-0 after:bg-blue-500 after:rounded-full after:transition-all after:duration-300 hover:after:w-full"
            aria-label={link.label}
            href={link.url}
            title={link.title}
          >
            <link.icon class="size-5 lg:hidden" />
            <span class="hidden lg:inline">{link.title}</span>
          </a>
        ))
      }
    </nav>
    <div class="w-24 shrink-0 flex justify-end">
      <LanguageSwitcher lang={lang} />
    </div>
  </div>
</header>

<script>
  function setupNavHighlight() {
    const sections = document.querySelectorAll("section[id]");
    const navItems = document.querySelectorAll("header nav a[aria-label]");
    const visibleSections = new Set<string>();

    function updateActive() {
      // Find the section closest to the top of the viewport among visible ones
      let activeId = "";
      let minTop = Infinity;
      visibleSections.forEach((id) => {
        const el = document.getElementById(id);
        if (el) {
          const top = Math.abs(el.getBoundingClientRect().top);
          if (top < minTop) {
            minTop = top;
            activeId = id;
          }
        }
      });
      // If scrolled to bottom, activate last section
      if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 50) {
        const allIds = Array.from(sections).map((s) => s.id).filter(Boolean);
        activeId = allIds[allIds.length - 1] || activeId;
      }
      navItems.forEach((item) => {
        if (item.getAttribute("aria-label") === activeId) {
          item.classList.add("text-blue-500");
        } else {
          item.classList.remove("text-blue-500");
        }
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.target.id) {
            if (entry.isIntersecting) {
              visibleSections.add(entry.target.id);
            } else {
              visibleSections.delete(entry.target.id);
            }
          }
        });
        updateActive();
      },
      { root: null, rootMargin: "0px", threshold: 0.1 },
    );

    sections.forEach((section) => observer.observe(section));

    window.addEventListener("scroll", updateActive, { passive: true });

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => observer.observe(section));
      }
    };

    return observer;
  }

  document.addEventListener("astro:page-load", () => {
    setupNavHighlight();
  });

  document.addEventListener("astro:after-swap", () => {
    setupNavHighlight();
  });
</script>

<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  nav {
    @apply bg-gray-800/90;
  }

  @keyframes nav-shadown {
    0% {
      @apply bg-gray-800/0;
    }
    to {
      @apply shadow-lg ring-1 backdrop-blur ring-white/10;
    }
  }
</style>
