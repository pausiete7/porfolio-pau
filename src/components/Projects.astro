---
import { Image } from "astro:assets";
import { PROJECTS as PROJECTS_DATA } from "@data/projects";
import type { ProjectTagId } from "@data/projects";
import Dart from "@icons/DartIcon.astro";
import Flutter from "@icons/FlutterIcon.astro";
import Supabase from "@icons/SupabaseIcon.astro";
import LinkIcon from "@icons/LinkIcon.astro";
import LinkButton from "@components/LinkButton.astro";
import SQLite from "@icons/SQLiteIcon.astro";
import GitHubIcon from "@icons/GitHubIcon.astro";
import AstroIcon from "@icons/AstroIcon.astro";
import HTML from "@icons/HtmlIcon.astro";
import CSS from "@icons/CssIcon.astro";
import Tailwind from "@icons/TailwindIcon.astro";

const TAGS: Record<
  ProjectTagId,
  { name: string; class: string; icon: (props: { class?: string }) => unknown }
> = {
  DART: {
    name: "Dart",
    class: "bg-[#0175C2] text-white",
    icon: Dart,
  },
  FLUTTER: {
    name: "Flutter",
    class: "bg-[#02569B] text-white",
    icon: Flutter,
  },
  SUPABASE: {
    name: "Supabase",
    class: "bg-[#333333] text-white",
    icon: Supabase,
  },
  SQLITE: {
    name: "SQLite",
    class: "bg-gray-500/80 text-white",
    icon: SQLite,
  },
  ASTRO: {
    name: "Astro",
    class: "bg-[#000000] text-white",
    icon: AstroIcon,
  },
  HTML: {
    name: "HTML",
    class: "bg-[#000000] text-white",
    icon: HTML,
  },
  CSS: {
    name: "CSS",
    class: "bg-[#000000] text-white",
    icon: CSS,
  },
  TAILWIND: {
    name: "Tailwind",
    class: "bg-[#000000] text-white",
    icon: Tailwind,
  },
};

const PROJECTS = PROJECTS_DATA.map((p) => ({
  title: p.title,
  description: p.descriptionShort ?? p.description,
  image: p.image,
  link: p.link ?? `/project/${p.slug}`,
  github: p.github,
  tags: p.tagIds.map((id) => TAGS[id]),
}));
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ title, description, tags, image, link, github }) => (
      <div class="border rounded-lg shadow lg:max-w-full  border-gray-700 bg-gray-800 flex flex-col gap-y-6 mx-auto lg:flex-row lg:gap-x-6 items-stretch">
        <Image
          src={image}
          alt={`Captura del proyecto ${title}`}
          width={600}
          height={384}
          class="object-cover w-full rounded-t-lg md:rounded-none md:rounded-s-lg h-96"
        />
        <div class="flex flex-col justify-between p-4 leading-normal mb-5">
          <h5 class="mb-2 text-2xl font-bold tracking-tight text-white">
            {title}
          </h5>
          <ul class="flex flex-row mb-5 gap-x-2">
            {tags.map((tag) => (
              <li>
                <span
                  class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
                >
                  <tag.icon class="size-4" />
                  {tag.name}
                </span>
              </li>
            ))}
          </ul>
          <p class="mb-3 font-normal text-gray-300 ">{description}</p>
          <footer class="flex items-end justify-start mt-4 gap-x-4">
            {link && (
              <LinkButton href={link}>
                <LinkIcon class="size-4" />
                Ver más
              </LinkButton>
            )}
            {github && (
              <LinkButton href={github} target="_blank">
                <GitHubIcon class="size-4" />
                Github
              </LinkButton>
            )}
          </footer>
        </div>
      </div>
    ))
  }
</div>
