---
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import LinkedinIcon from "@icons/LinkedinIcon.astro";
import GitHubIcon from "@icons/GitHubIcon.astro";
import InstagramIcon from "@icons/InstagramIcon.astro";
import XIcon from "@icons/XIcon.astro";
import MailIcon from "@icons/MailIcon.astro";
import AppStoreIcon from "@icons/AppStoreIcon.astro";
import GooglePlayIcon from "@icons/GooglePlayIcon.astro";
import ExternalLinkIcon from "@icons/ExternalLinkIcon.astro";
import photo from "@/assets/pau.jpg";
import { type Lang } from "@/i18n";
import { COPY, CONTACT, PROJECTS, type LinkKind } from "@data/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = COPY[lang];
const linkLabel: Record<LinkKind, string> = {
  appstore: c.projects.appstore,
  googleplay: c.projects.googleplay,
  web: c.projects.web,
};
const linkIcon = { appstore: AppStoreIcon, googleplay: GooglePlayIcon, web: ExternalLinkIcon };
const socials = [
  { href: CONTACT.linkedin, label: "LinkedIn", Icon: LinkedinIcon },
  { href: CONTACT.github, label: "GitHub", Icon: GitHubIcon },
  { href: CONTACT.instagram, label: "Instagram", Icon: InstagramIcon },
  { href: CONTACT.x, label: "X", Icon: XIcon },
];
---

<Layout lang={lang}>
  <main id="contenido">
    <!-- Portada -->
    <section class="hero wrap" aria-labelledby="titulo">
      <div class="hero-text">
        <p class="badge"><span class="dot" aria-hidden="true"></span>{c.hero.badge}</p>
        <h1 id="titulo">Pau Sevilla</h1>
        <p class="role">{c.hero.role}</p>
        <p class="summary">{c.hero.summary}</p>
        <div class="ctas">
          <a class="btn primary" href="#proyectos">{c.hero.ctaProjects}</a>
          <a class="btn" href={`mailto:${CONTACT.email}`}>{c.hero.ctaContact}</a>
        </div>
        <ul class="socials">
          {socials.map(({ href, label, Icon }) => (
            <li>
              <a href={href} target="_blank" rel="noopener" aria-label={label} title={label}>
                <Icon class="icon" />
              </a>
            </li>
          ))}
        </ul>
      </div>
      <Image
        src={photo}
        alt={c.hero.photoAlt}
        widths={[240, 400, 640]}
        sizes="(min-width: 768px) 300px, 180px"
        class="portrait"
        loading="eager"
        fetchpriority="high"
      />
    </section>

    <!-- Cifras -->
    <section class="wrap" aria-label="Datos">
      <dl class="stats">
        {c.stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Proyectos -->
    <section id="proyectos" class="wrap block" aria-labelledby="h-proyectos">
      <header class="block-head">
        <h2 id="h-proyectos">{c.projects.title}</h2>
        <p>{c.projects.intro}</p>
      </header>
      <ul class="projects">
        {PROJECTS.map((p) => {
          const t = p.text[lang];
          return (
            <li class="card">
              <div class={`shot ${p.shot}`}>
                <Image src={p.image} alt={t.imageAlt} widths={[280, 420, 560]} sizes="(min-width: 768px) 260px, 60vw" loading="lazy" />
              </div>
              <div class="card-body">
                <div class="card-top">
                  <h3>{p.name}</h3>
                  <span class="year">{p.year}</span>
                </div>
                {t.metric && <p class="metric">{t.metric}</p>}
                <p class="card-text">{t.summary}</p>
                <p class="stack">{p.stack.join(" · ")}</p>
                <ul class="links">
                  {p.links.map((l) => {
                    const Icon = linkIcon[l.kind];
                    return (
                      <li>
                        <a href={l.url} target="_blank" rel="noopener">
                          <Icon class="icon-sm" />
                          {linkLabel[l.kind]}
                          <span class="sr-only"> · {p.name}</span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- Experiencia -->
    <section id="experiencia" class="wrap block" aria-labelledby="h-exp">
      <header class="block-head">
        <h2 id="h-exp">{c.experience.title}</h2>
      </header>
      <article class="job">
        <div class="job-head">
          <div>
            <h3><a href="https://inlab.fib.upc.edu/" target="_blank" rel="noopener">{c.experience.org}</a></h3>
            <p class="job-role">{c.experience.role}</p>
          </div>
          <p class="job-date">{c.experience.date} · {c.experience.place}</p>
        </div>
        <ul class="job-items">
          {c.experience.items.map((it) => (
            <li>
              <h4>{it.title}</h4>
              <p>{it.text}</p>
              <p class="stack">{it.stack}</p>
            </li>
          ))}
        </ul>
      </article>
    </section>

    <!-- IA -->
    <section class="wrap block" aria-labelledby="h-ia">
      <div class="callout">
        <h2 id="h-ia">{c.ai.title}</h2>
        <p>{c.ai.text}</p>
      </div>
    </section>

    <!-- Sobre mí, formación, habilidades -->
    <section id="sobre-mi" class="wrap block two" aria-labelledby="h-about">
      <div>
        <h2 id="h-about">{c.about.title}</h2>
        <p>{c.about.text}</p>
        <h3 class="sub">{c.about.educationTitle}</h3>
        <ul class="edu">
          {c.about.education.map((e) => (
            <li>
              <div class="edu-top"><strong>{e.title}</strong><span>{e.date}</span></div>
              <p>{e.detail}</p>
            </li>
          ))}
        </ul>
        <h3 class="sub">{c.about.languagesTitle}</h3>
        <p>{c.about.languages}</p>
      </div>
      <div>
        <h2>{c.skills.title}</h2>
        <dl class="skills">
          {c.skills.groups.map((g) => (
            <div>
              <dt>{g.name}</dt>
              <dd>
                <ul class="chips">{g.items.map((i) => <li>{i}</li>)}</ul>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Contacto -->
    <section id="contacto" class="wrap block" aria-labelledby="h-contact">
      <div class="contact">
        <h2 id="h-contact">{c.contact.title}</h2>
        <p>{c.contact.text}</p>
        <a class="btn primary big" href={`mailto:${CONTACT.email}`}>
          <MailIcon class="icon-sm" />
          {CONTACT.email}
        </a>
        <ul class="socials center">
          {socials.map(({ href, label, Icon }) => (
            <li>
              <a href={href} target="_blank" rel="noopener" aria-label={label} title={label}>
                <Icon class="icon" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</Layout>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* Portada */
  .hero {
    display: grid; gap: 1.75rem; align-items: center;
    padding-block: 2.5rem 1.5rem;
  }
  .hero-text { order: 2; }
  .portrait {
    order: 1; width: 132px; height: 132px; object-fit: cover; object-position: 50% 30%;
    border-radius: 22px; border: 1px solid var(--line);
  }
  .badge {
    display: inline-flex; align-items: center; gap: 0.5rem; margin: 0 0 1rem;
    font-size: 0.85rem; font-weight: 700; color: var(--muted);
    padding: 0.3rem 0.75rem; border: 1px solid var(--line); border-radius: 999px; background: var(--surface);
  }
  .dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #1f9d55; }
  h1 { font-size: clamp(2.4rem, 9vw, 3.6rem); font-weight: 700; margin: 0; }
  .role { font-family: var(--font-head); font-weight: 500; font-size: clamp(1.1rem, 4vw, 1.35rem); color: var(--accent); margin: 0.35rem 0 1rem; }
  .summary { color: var(--muted); max-width: 60ch; margin: 0 0 1.5rem; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    min-height: 48px; padding: 0 1.25rem; border-radius: 12px;
    font-weight: 700; text-decoration: none; color: var(--ink);
    border: 1px solid var(--line); background: var(--surface);
    transition: transform 150ms ease, background-color 150ms ease;
  }
  .btn:hover { background: var(--surface-2); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .btn.primary:hover { transform: translateY(-1px); }
  .btn.big { font-size: 1.05rem; padding: 0 1.5rem; word-break: break-all; }
  .socials { display: flex; gap: 0.5rem; list-style: none; margin: 1.25rem 0 0; padding: 0; }
  .socials.center { justify-content: center; }
  .socials a {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px;
    color: var(--muted); border: 1px solid var(--line); background: var(--surface);
  }
  .socials a:hover { color: var(--ink); background: var(--surface-2); }
  :global(.icon) { width: 20px; height: 20px; }
  :global(.icon-sm) { width: 18px; height: 18px; flex: none; }

  /* Cifras */
  .stats {
    display: grid; margin: 0;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
  }
  .stats > div {
    display: flex; flex-direction: row-reverse; justify-content: flex-end; align-items: center; gap: 0.9rem;
    padding: 0.85rem 1.1rem;
  }
  .stats > div + div { border-top: 1px solid var(--line); }
  .stats dt { color: var(--muted); font-size: 0.95rem; line-height: 1.35; }
  .stats dd { margin: 0; min-width: 5.2rem; font-family: var(--font-head); font-weight: 700; font-size: 1.5rem; color: var(--accent); }

  /* Bloques */
  .block { padding-top: 3.5rem; }
  .block-head { margin-bottom: 1.5rem; }
  .block-head p { color: var(--muted); margin: 0.35rem 0 0; }
  h2 { font-size: clamp(1.5rem, 5vw, 2rem); font-weight: 600; margin: 0; }

  /* Proyectos */
  .projects { display: grid; gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
  .card {
    display: grid; overflow: hidden;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
  }
  .shot {
    display: grid; place-items: end center; padding: 1.5rem 1.5rem 0; background: var(--surface-2);
    height: 220px; overflow: hidden;
  }
  .shot :global(img) {
    width: 62%; max-width: 230px; height: auto; display: block;
    border-radius: 18px 18px 0 0; border: 1px solid var(--line); border-bottom: 0;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.12);
  }
  .shot.web :global(img) { width: 80%; max-width: 300px; border-radius: 12px 12px 0 0; }
  .card-body { padding: 1.1rem 1.2rem 1.25rem; display: flex; flex-direction: column; gap: 0.55rem; }
  .card-top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  h3 { font-size: 1.2rem; font-weight: 600; margin: 0; }
  .year { color: var(--muted); font-size: 0.9rem; white-space: nowrap; }
  .metric { margin: 0; font-weight: 700; color: var(--accent); }
  .card-text { margin: 0; font-size: 1rem; }
  .stack { margin: 0; color: var(--muted); font-size: 0.9rem; }
  .links { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 0.35rem 0 0; padding: 0; }
  .links a {
    display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; padding: 0 0.85rem;
    border: 1px solid var(--line); border-radius: 10px; text-decoration: none; color: var(--ink); font-weight: 700; font-size: 0.92rem;
  }
  .links a:hover { background: var(--surface-2); }

  /* Experiencia */
  .job { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem; }
  .job-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1.5rem; margin-bottom: 1rem; }
  .job-head h3 a { color: var(--ink); text-decoration-color: var(--line); text-underline-offset: 4px; }
  .job-role, .job-date { margin: 0.2rem 0 0; color: var(--muted); }
  .job-items { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  .job-items li { padding-left: 1rem; border-left: 3px solid var(--line); }
  h4 { font-family: var(--font-head); font-size: 1.02rem; font-weight: 600; margin: 0 0 0.2rem; }
  .job-items p { margin: 0 0 0.2rem; }

  /* IA */
  .callout { background: var(--surface-2); border-radius: var(--radius); padding: 1.4rem 1.3rem; }
  .callout p { margin: 0.6rem 0 0; max-width: 75ch; }

  /* Sobre mí y habilidades */
  .two { display: grid; gap: 2.5rem; }
  .two p { margin: 0.6rem 0 0; }
  .sub { font-size: 1.05rem; margin: 1.5rem 0 0.5rem; }
  .edu { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .edu-top { display: flex; justify-content: space-between; gap: 1rem; }
  .edu-top span { color: var(--muted); white-space: nowrap; font-size: 0.92rem; }
  .edu p { margin: 0.1rem 0 0; color: var(--muted); }
  .skills { margin: 0.6rem 0 0; display: grid; gap: 1rem; }
  .skills dt { font-weight: 700; margin-bottom: 0.4rem; }
  .skills dd { margin: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; margin: 0; padding: 0; }
  .chips li { padding: 0.3rem 0.65rem; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); font-size: 0.92rem; }

  /* Contacto */
  .contact { text-align: center; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 2rem 1.25rem; }
  .contact p { color: var(--muted); margin: 0.6rem auto 1.25rem; max-width: 50ch; }

  @media (min-width: 640px) {
    .stats { grid-template-columns: repeat(3, 1fr); }
    .stats > div { flex-direction: column-reverse; align-items: flex-start; gap: 0.1rem; padding: 1.1rem 1.25rem; }
    .stats > div + div { border-top: 0; border-left: 1px solid var(--line); }
    .stats dd { font-size: 1.85rem; min-width: 0; }
  }

  @media (min-width: 768px) {
    .hero { grid-template-columns: 1fr auto; gap: 3rem; padding-block: 4.5rem 2.5rem; }
    .hero-text { order: 1; }
    .portrait { order: 2; width: 280px; height: 300px; border-radius: 28px; }
    .projects { grid-template-columns: repeat(2, 1fr); }
    .card { grid-template-rows: auto 1fr; }
    .shot { height: 250px; }
    .two { grid-template-columns: 1fr 1fr; gap: 3rem; }
    .block { padding-top: 5rem; }
    .job { padding: 1.75rem; }
    .job-items { grid-template-columns: 1fr 1fr; gap: 1.5rem 2rem; }
  }

  @media (min-width: 1100px) {
    .projects { grid-template-columns: repeat(3, 1fr); }
  }
</style>
