---
import { Image } from "astro:assets";
import ExternalLinkIcon from "@icons/ExternalLinkIcon.astro";
import { useTranslations, type Lang } from "@/i18n";

interface Props {
  title: string;
  description: string;
  date: string;
  link?: string;
  image?: string;
  lang: Lang;
}

const { title, description, date, link, image, lang } = Astro.props;
const t = useTranslations(lang);
---

<div
  class="relative mx-8 pb-12 grid gap-y-2 before:absolute before:left-[-19px] before:block before:h-full before:border-l-2 before:border-blue-500/30 before:content-[''] md:grid-cols-5 md:gap-10 md:space-x-4"
>
  <div class="relative pb-12 md:col-span-2 p-4 bg-gray-800/60 rounded-lg border border-white/5 hover:border-blue-500/20 transition-colors duration-300">
    <div class="sticky top-0 flex flex-col items-center text-center gap-y-2">
      <span class="absolute -left-[41px] top-2 w-3 h-3 rounded-full bg-blue-500 ring-4 ring-gray-900 shadow-lg shadow-blue-500/30"></span>

      <h3 class="text-xl font-semibold text-blue-500">{title}</h3>
      <time class="text-sm text-gray-300">{date}</time>

      {
        link && image && (
          <div class="flex flex-col items-center gap-y-2 mt-2">
            <div class="w-24 h-10 flex items-center justify-center">
              <Image
                src={image}
                alt={t("experience.companyLogoAlt")}
                width={96}
                height={40}
                class="max-w-full max-h-full object-contain rounded-lg"
              />
            </div>
            <a
              href={link}
              target="_blank"
              rel="noopener"
              class="text-sm text-gray-300 hover:text-white hover:scale-105 transition inline-flex items-center gap-x-2"
            >
              <ExternalLinkIcon class="size-4" />
              {t("experience.visitCompany")}
            </a>
          </div>
        )
      }
    </div>
  </div>
  <div
    class="relative flex flex-col gap-2 text-gray-300 md:col-span-3 p-4 bg-gray-800/60 rounded-lg border border-white/5 hover:border-blue-500/20 transition-colors duration-300"
  >
    {description}
  </div>
</div>
