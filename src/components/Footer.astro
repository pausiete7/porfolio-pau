---
import { type Lang } from "@/i18n";
import { COPY } from "@data/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<footer class="site-footer">
  <div class="wrap">
    <p>© {new Date().getFullYear()} Pau Sevilla Rodríguez. {COPY[lang].footer}</p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); margin-top: 4rem; }
  p { margin: 0; padding-block: 1.75rem; color: var(--muted); font-size: 0.9rem; }
</style>
