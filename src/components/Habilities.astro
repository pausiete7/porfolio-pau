---
import { SKILL_TAGS, type TagDefinition } from "@data/tags";
import { useTranslations, type Lang } from "@/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const BLOCS: { title: string; tags: TagDefinition[] }[] = [
  {
    title: t("skills.frontend"),
    tags: [
      SKILL_TAGS.FLUTTER,
      SKILL_TAGS.REACT,
      SKILL_TAGS.ASTRO,
      SKILL_TAGS.HTML,
      SKILL_TAGS.CSS,
      SKILL_TAGS.TAILWIND,
      SKILL_TAGS.ANGULAR,
    ],
  },
  {
    title: t("skills.backend"),
    tags: [
      SKILL_TAGS.SUPABASE,
      SKILL_TAGS.POSTGRE,
      SKILL_TAGS.DIGITALOCEAN,
      SKILL_TAGS.SQLITE,
      SKILL_TAGS.LARAVEL,
    ],
  },
  {
    title: t("skills.languages"),
    tags: [SKILL_TAGS.DART, SKILL_TAGS.JS, SKILL_TAGS.PYTHON, SKILL_TAGS.C, SKILL_TAGS.TYPESCRIPT],
  },
  {
    title: t("skills.tools"),
    tags: [SKILL_TAGS.FIGMA, SKILL_TAGS.VS, SKILL_TAGS.GIT, SKILL_TAGS.GITHUB, SKILL_TAGS.POSTMAN],
  },
];
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  {
    BLOCS.map(({ title, tags }) => (
      <section class="flex flex-col items-center bg-gray-800/70 rounded-lg  shadow-lg p-6 h-full border border-blue-500">
        <h2 class="text-xl font-bold text-blue-500 pb-4 ">{title}</h2>
        <ul class="grid grid-cols-2 lg:grid-cols-3 gap-5 w-full">
          {tags.map((tag) => (
            <li
              class={`flex flex-col gap-y-2 rounded-lg items-center justify-between text-sm shadow-2xl bg-gray-800 p-4 border border-blue-500  transition hover:scale-105`}
            >
              <tag.icon class="size-9" />
              <h3 class="text-xs text-white/80">{tag.name}</h3>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
