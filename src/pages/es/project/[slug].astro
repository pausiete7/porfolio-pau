---
import { buildProjectForDetail, getProjectsWithDetail } from "@data/project-detail";
import ProjectDetail from "@components/ProjectDetail.astro";

const lang = "es" as const;

export function getStaticPaths() {
  return getProjectsWithDetail().map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const detail = buildProjectForDetail(project, lang);
---

<ProjectDetail {...detail} lang={lang} />
