---
import Layout from "@layouts/Layout.astro";
import Educacion from "@components/Educacion.astro";
import SectionContainer from "@components/SectionContainer.astro";
import Hero from "@components/Hero.astro";
import TitleSection from "@components/TitleSection.astro";
import AboutMe from "@components/AboutMe.astro";
import Habilities from "@components/Habilities.astro";
import Proyectos from "@components/Projects.astro";
import BooksIcon from "@icons/BooksIcon.astro";
import ProfileIcon from "@icons/ProfileIcon.astro";
import BrainIcon from "@icons/BrainIcon.astro";
import CodeIcon from "@icons/CodeIcon.astro";
import Experience from "@components/Experience.astro";
import BriefcaseIcon from "@icons/BriefcaseIcon.astro";
import { useTranslations } from "@/i18n";

const lang = "ca" as const;
const t = useTranslations(lang);
---

<Layout lang={lang}>
  <main class="px-4">
    <SectionContainer class="pt-16 md:pt-32 pb-20">
      <Hero lang={lang} />
    </SectionContainer>
    <SectionContainer id="sobre-mi">
      <TitleSection>
        <ProfileIcon class="size-8" />
        {t("section.about")}
      </TitleSection>
      <AboutMe lang={lang} />
    </SectionContainer>
    <SectionContainer id="experiencia" class="py-20">
      <TitleSection>
        <BriefcaseIcon class="size-8" />
        {t("section.experience")}
      </TitleSection>
      <Experience lang={lang} />
    </SectionContainer>
    <SectionContainer id="educacion" class="py-20">
      <TitleSection>
        <BooksIcon class="size-8" />
        {t("section.education")}
      </TitleSection>
      <Educacion lang={lang} />
    </SectionContainer>
    <SectionContainer id="proyectos">
      <TitleSection>
        <CodeIcon class="size-7" />
        {t("section.projects")}
      </TitleSection>
      <Proyectos lang={lang} />
    </SectionContainer>
    <SectionContainer id="habilidades" class="pt-20">
      <TitleSection>
        <BrainIcon class="size-8" />
        {t("section.skills")}
      </TitleSection>
      <Habilities lang={lang} />
    </SectionContainer>
  </main>
</Layout>
