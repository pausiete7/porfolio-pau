---
import { PROJECTS, getProjectsWithDetail } from "@data/projects";
import ProjectDetail from "@components/ProjectDetail.astro";
import Dart from "@icons/DartIcon.astro";
import Flutter from "@icons/FlutterIcon.astro";
import Supabase from "@icons/SupabaseIcon.astro";
import SQLite from "@icons/SQLiteIcon.astro";
import GitHubIcon from "@icons/GitHubIcon.astro";
import AppStoreIcon from "@icons/AppStoreIcon.astro";
import GooglePlayIcon from "@icons/GooglePlayIcon.astro";
import AstroIcon from "@icons/AstroIcon.astro";
import HTML from "@icons/HtmlIcon.astro";
import CSS from "@icons/CssIcon.astro";
import Tailwind from "@icons/TailwindIcon.astro";
import type { ProjectData, ProjectLinkType, ProjectTagId } from "@data/projects";

const TAGS: Record<
  ProjectTagId,
  { name: string; class: string; icon: (props: { class?: string }) => unknown }
> = {
  DART: {
    name: "Dart",
    class: "bg-[#0175C2] text-white",
    icon: Dart,
  },
  FLUTTER: {
    name: "Flutter",
    class: "bg-[#02569B] text-white",
    icon: Flutter,
  },
  SUPABASE: {
    name: "Supabase",
    class: "bg-[#333333] text-white",
    icon: Supabase,
  },
  SQLITE: {
    name: "SQLite",
    class: "bg-gray-500/80 text-white",
    icon: SQLite,
  },
  ASTRO: {
    name: "Astro",
    class: "bg-[#000000] text-white",
    icon: AstroIcon,
  },
  HTML: { name: "HTML", class: "bg-[#000000] text-white", icon: HTML },
  CSS: { name: "CSS", class: "bg-[#000000] text-white", icon: CSS },
  TAILWIND: {
    name: "Tailwind",
    class: "bg-[#000000] text-white",
    icon: Tailwind,
  },
};

const LINK_ICONS: Record<
  ProjectLinkType,
  (props: { class?: string }) => unknown
> = {
  appstore: AppStoreIcon,
  googleplay: GooglePlayIcon,
  github: GitHubIcon,
};

function buildProjectForDetail(raw: ProjectData) {
  const tags = raw.tagIds.map((id) => TAGS[id]);
  const links =
    raw.links?.map((l) => ({
      titleSection: l.titleSection,
      link: l.url,
      icon: LINK_ICONS[l.type],
    })) ?? [];
  return {
    slug: raw.slug,
    title: raw.title,
    title_l: raw.title_l ?? raw.title,
    date: raw.date ?? "",
    description: raw.description,
    imgs: raw.imgs ?? [],
    tags,
    links,
  };
}

export function getStaticPaths() {
  return getProjectsWithDetail().map((p) => ({
    params: { slug: p.slug },
    props: { project: buildProjectForDetail(p) },
  }));
}

const { project } = Astro.props;
---

<ProjectDetail {...project} />
